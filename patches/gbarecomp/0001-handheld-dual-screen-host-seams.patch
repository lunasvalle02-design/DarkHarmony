+// Thread-safe requests from game-owned UI (e.g. a touch screen) to the host.
+// They are applied at the next pump(), a clean boundary between frames.
+enum class HostRequest : int {
+    Quit = 0,         // leave the game (cartridge save is flushed as usual)
+    SaveState,        // value = slot 1..10
+    LoadState,        // value = slot 1..10
+    SetVolume,        // value = 0..100
+    SetScaleMode,     // value = see HostWindow::set_scale_mode
+    SetLinearFilter,  // value = 0/1
+    FastForward,      // value = 0/1, level-triggered while set
+    SwapAB,           // value = 0/1, swaps controller A/B onto GBA A/B
+    FlushSave,        // write the cartridge save now
+    SuspendState,     // flush the save and write the suspend state
+    Resumed,          // the device woke up: clear marker, reset pacing
+    AudioEnabled,     // value = 0/1
+    Count
+};
+void host_request(HostRequest request, int value = 0);
