diff --git a/src/armv4t/runtime_guest_fastpath.h b/src/armv4t/runtime_guest_fastpath.h
new file mode 100644
index 0000000..e7a4a9e
--- /dev/null
+++ b/src/armv4t/runtime_guest_fastpath.h
@@ -0,0 +1,219 @@
+// runtime_guest_fastpath.h — inline fast paths for the per-instruction runtime
+// calls of generated code (opt-in: GBARECOMP_INLINE_FASTPATH, defined only
+// for the translation units of a game's generated code).
+//
+// Generated code calls runtime_should_yield() and runtime_tick() once per
+// guest instruction, a bus helper plus runtime_mem_cycles() per access and a
+// flag helper for most Thumb instructions. On small in-order cores
+// (Cortex-A55) those out-of-line calls dominate the frame. The wrappers below
+// handle the common case inline and fall back to the unchanged runtime
+// functions whenever anything could differ:
+//
+//   tick   — inline only while the next device event is still ahead
+//            (g_rt.budget, the runtime's event budget, stays > 0). Anything
+//            that could make the full tick behave differently — materialized
+//            device state, an MMIO write, a CPSR write that may unmask an IRQ,
+//            an input pump or a state load — zeroes the budget
+//            (runtime_fastpath_invalidate), so the next tick runs the full
+//            runtime_tick (device catch-up, DMA steal, IRQ check) as before.
+//   yield  — inline "no" only outside the BIOS while g_rt.yield_slow is clear;
+//            the full runtime_should_yield() recomputes it and every device
+//            materialization (VBlank start, HALT, …) sets it.
+//   memory — EWRAM/IWRAM and plain cartridge ROM accesses go straight to the
+//            backing arrays while no bus write observer, read override,
+//            GPIO, EEPROM or ROM mapper is involved (g_rt.mem_fast,
+//            g_rt.rom_fast). Everything else takes the full bus path.
+//
+// The state shares one struct so a function addresses it from one base.
+// Session (netplay) execution and shadow ticks keep the budget at zero, i.e.
+// the full path on every call.
+#pragma once
+
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern unsigned long long g_runtime_cycles;
+extern unsigned long long g_idle_disturb_epoch;
+
+// Sub-switches (all on by default) to weigh code size against calls.
+#ifndef GBARECOMP_FASTPATH_MEM
+#define GBARECOMP_FASTPATH_MEM 1
+#endif
+#ifndef GBARECOMP_FASTPATH_FLAGS
+#define GBARECOMP_FASTPATH_FLAGS 1
+#endif
+
+#if defined(__GNUC__)
+#define RT_LIKELY(x) __builtin_expect(!!(x), 1)
+#define RT_INLINE static inline __attribute__((always_inline))
+#else
+#define RT_LIKELY(x) (x)
+#define RT_INLINE static inline
+#endif
+
+// The full functions are the rare path here: keep their call sequences out of
+// the hot instruction stream.
+#if defined(__GNUC__)
+void runtime_tick(uint32_t cycles) __attribute__((cold));
+bool runtime_should_yield(void) __attribute__((cold));
+#endif
+
+RT_INLINE void rt_fast_tick(uint32_t cycles) {
+    const long long budget = g_rt.budget - (long long)cycles;
+    if (RT_LIKELY(budget > 0)) {
+        g_rt.budget = budget;
+        g_rt.pending += cycles;
+        g_rt.cycles += cycles;
+        return;
+    }
+    runtime_tick(cycles);
+}
+
+RT_INLINE bool rt_fast_should_yield(void) {
+    if (RT_LIKELY(g_rt.yield_slow == 0u && g_cpu.R[15] >= 0x00004000u)) return false;
+    return runtime_should_yield();
+}
+
+RT_INLINE uint32_t rt_fast_mem_cycles(uint32_t addr, uint32_t width, uint32_t sequential) {
+    const uint32_t region = addr >> 24;
+    if (region > 0xFu) return 1u;
+    if (region >= 0xEu) return 1u + g_runtime_waits.n16[region];
+    if (width == 4u) return 1u + (sequential ? g_runtime_waits.s32[region] : g_runtime_waits.n32[region]);
+    return 1u + (sequential ? g_runtime_waits.s16[region] : g_runtime_waits.n16[region]);
+}
+
+// Backing pointer for a direct access of `width` bytes at `addr`, or null.
+RT_INLINE const uint8_t* rt_fast_read_ptr(uint32_t addr, uint32_t width) {
+    const uint32_t region = addr >> 24;
+    if (region == 0x02u) return g_rt.mem_fast ? g_rt.ewram + (addr & 0x3FFFFu) : 0;
+    if (region == 0x03u) return g_rt.mem_fast ? g_rt.iwram + (addr & 0x7FFFu) : 0;
+    if (region >= 0x08u && region <= 0x0Du && g_rt.rom_fast) {
+        const uint32_t off = addr & 0x01FFFFFFu;
+        if (off + width <= g_rt.rom_size) return g_rt.rom + off;
+    }
+    return 0;
+}
+
+RT_INLINE uint8_t* rt_fast_write_ptr(uint32_t addr) {
+    if (!g_rt.mem_fast) return 0;
+    const uint32_t region = addr >> 24;
+    if (region == 0x02u) return g_rt.ewram + (addr & 0x3FFFFu);
+    if (region == 0x03u) return g_rt.iwram + (addr & 0x7FFFu);
+    return 0;
+}
+
+RT_INLINE uint32_t rt_fast_read_u32(uint32_t addr) {
+    const uint8_t* p = rt_fast_read_ptr(addr, 4u);
+    if (RT_LIKELY(p != 0)) { uint32_t v; memcpy(&v, p, 4); return v; }
+    return bus_read_u32(addr);
+}
+RT_INLINE uint16_t rt_fast_read_u16(uint32_t addr) {
+    const uint8_t* p = rt_fast_read_ptr(addr, 2u);
+    if (RT_LIKELY(p != 0)) { uint16_t v; memcpy(&v, p, 2); return v; }
+    return bus_read_u16(addr);
+}
+RT_INLINE uint8_t rt_fast_read_u8(uint32_t addr) {
+    const uint8_t* p = rt_fast_read_ptr(addr, 1u);
+    if (RT_LIKELY(p != 0)) return *p;
+    return bus_read_u8(addr);
+}
+RT_INLINE void rt_fast_write_u32(uint32_t addr, uint32_t v) {
+    uint8_t* p = rt_fast_write_ptr(addr);
+    if (RT_LIKELY(p != 0)) { memcpy(p, &v, 4); ++g_idle_disturb_epoch; return; }
+    bus_write_u32(addr, v);
+}
+RT_INLINE void rt_fast_write_u16(uint32_t addr, uint16_t v) {
+    uint8_t* p = rt_fast_write_ptr(addr);
+    if (RT_LIKELY(p != 0)) { memcpy(p, &v, 2); ++g_idle_disturb_epoch; return; }
+    bus_write_u16(addr, v);
+}
+RT_INLINE void rt_fast_write_u8(uint32_t addr, uint8_t v) {
+    uint8_t* p = rt_fast_write_ptr(addr);
+    if (RT_LIKELY(p != 0)) { *p = v; ++g_idle_disturb_epoch; return; }
+    bus_write_u8(addr, v);
+}
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#define runtime_tick(c) rt_fast_tick(c)
+#define runtime_should_yield() rt_fast_should_yield()
+#define runtime_mem_cycles(a, w, s) rt_fast_mem_cycles((a), (w), (s))
+#if GBARECOMP_FASTPATH_MEM
+#define bus_read_u32(a) rt_fast_read_u32(a)
+#define bus_read_u16(a) rt_fast_read_u16(a)
+#define bus_read_u8(a) rt_fast_read_u8(a)
+#define bus_write_u32(a, v) rt_fast_write_u32((a), (v))
+#define bus_write_u16(a, v) rt_fast_write_u16((a), (v))
+#define bus_write_u8(a, v) rt_fast_write_u8((a), (v))
+#endif
+
+// ── Flags and conditions (same semantics as runtime_arm.cpp, inline) ──
+RT_INLINE void rt_set_nz(uint32_t r) {
+    uint32_t c = g_cpu.cpsr & ~(CPSR_N_BIT | CPSR_Z_BIT);
+    c |= r & 0x80000000u;  // N is bit 31
+    if (r == 0) c |= CPSR_Z_BIT;
+    g_cpu.cpsr = c;
+}
+RT_INLINE void rt_set_nzc_logic(uint32_t r, uint32_t shifter_carry) {
+    uint32_t c = g_cpu.cpsr & ~(CPSR_N_BIT | CPSR_Z_BIT | CPSR_C_BIT);
+    c |= r & 0x80000000u;
+    if (r == 0) c |= CPSR_Z_BIT;
+    if (shifter_carry) c |= CPSR_C_BIT;
+    g_cpu.cpsr = c;
+}
+RT_INLINE void rt_set_nzcv_add(uint32_t a, uint32_t b, uint32_t r) {
+    uint32_t c = g_cpu.cpsr & ~(CPSR_N_BIT | CPSR_Z_BIT | CPSR_C_BIT | CPSR_V_BIT);
+    c |= r & 0x80000000u;
+    if (r == 0) c |= CPSR_Z_BIT;
+    if (r < a) c |= CPSR_C_BIT;
+    if ((~(a ^ b) & (a ^ r)) & 0x80000000u) c |= CPSR_V_BIT;
+    g_cpu.cpsr = c;
+}
+RT_INLINE void rt_set_nzcv_sub(uint32_t a, uint32_t b, uint32_t r) {
+    uint32_t c = g_cpu.cpsr & ~(CPSR_N_BIT | CPSR_Z_BIT | CPSR_C_BIT | CPSR_V_BIT);
+    c |= r & 0x80000000u;
+    if (r == 0) c |= CPSR_Z_BIT;
+    if (a >= b) c |= CPSR_C_BIT;
+    if (((a ^ b) & (a ^ r)) & 0x80000000u) c |= CPSR_V_BIT;
+    g_cpu.cpsr = c;
+}
+RT_INLINE int rt_cond_passes(unsigned cond) {
+    const uint32_t n = cpsr_n(), z = cpsr_z(), c = cpsr_c(), v = cpsr_v();
+    switch (cond & 0xFu) {
+        case 0x0: return z != 0;
+        case 0x1: return z == 0;
+        case 0x2: return c != 0;
+        case 0x3: return c == 0;
+        case 0x4: return n != 0;
+        case 0x5: return n == 0;
+        case 0x6: return v != 0;
+        case 0x7: return v == 0;
+        case 0x8: return (c != 0) && (z == 0);
+        case 0x9: return (c == 0) || (z != 0);
+        case 0xA: return n == v;
+        case 0xB: return n != v;
+        case 0xC: return (z == 0) && (n == v);
+        case 0xD: return (z != 0) || (n != v);
+        case 0xE: return 1;
+        default:  return 0;  // NV: never on ARMv4T
+    }
+}
+#if GBARECOMP_FASTPATH_FLAGS
+#define arm_set_nz(r) rt_set_nz(r)
+#define arm_set_nzc_logic(r, c) rt_set_nzc_logic((r), (c))
+#define arm_set_nzcv_add(a, b, r) rt_set_nzcv_add((a), (b), (r))
+#define arm_set_nzcv_sub(a, b, r) rt_set_nzcv_sub((a), (b), (r))
+#define arm_cond_passes(c) rt_cond_passes(c)
+#endif
+
+// ── Debug hooks the port never arms: compiled out of the game code ──
+// (instruction trace, runtime trace ring, function-entry hook).
+#define g_runtime_insn_trace 0u
+#define runtime_trace_enabled() 0
+#define g_runtime_fn_entry_hook ((void (*)(uint32_t))0)
