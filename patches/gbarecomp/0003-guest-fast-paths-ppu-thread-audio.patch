+// ── Scanline worker (opt-in: GBARECOMP_PPU_THREAD=1) ─────────────────────────
+// Composes visible scanlines on a second core. Each job carries this line's
+// display registers (the affine-adjusted IO image), palette and OAM as they
+// are at the line's HBlank, i.e. what the inline call would have read; only
+// VRAM is read live. render_scanline_internal reads nothing else, so the image
+// matches the inline renderer unless the game rewrites VRAM tiles of a line
+// within the ~1 line the worker trails behind. Every reader of the work
+// framebuffer (latch, render, reset, state load) waits for it first.
+namespace {
+
+struct ScanlineJob {
+    uint8_t* fb;
+    uint32_t y;
+    uint16_t dispcnt;
+    const uint8_t* vram;
+    std::array<uint8_t, 0x60> io;
+    std::array<uint8_t, 0x400> pal;
+    std::array<uint8_t, 0x400> oam;
+};
+
+class ScanlineWorker {
+public:
+    static ScanlineWorker* get() {
+        static const bool enabled = [] {
+            const char* e = std::getenv("GBARECOMP_PPU_THREAD");
+            return e && e[0] == '1';
+        }();
+        if (!enabled) return nullptr;
+        static ScanlineWorker worker;
+        return &worker;
+    }
+
+    void submit(uint8_t* fb, uint32_t y, uint16_t dispcnt, const uint8_t* io,
+                const uint8_t* vram, const uint8_t* oam, const uint8_t* pal) {
+        const uint64_t n = submitted_.load(std::memory_order_relaxed);
+        while (n - done_.load(std::memory_order_acquire) >= kRing - 1) std::this_thread::yield();
+        ScanlineJob& job = jobs_[n % kRing];
+        job.fb = fb;
+        job.y = y;
+        job.dispcnt = dispcnt;
+        job.vram = vram;
+        std::memcpy(job.io.data(), io, job.io.size());
+        std::memcpy(job.pal.data(), pal, job.pal.size());
+        std::memcpy(job.oam.data(), oam, job.oam.size());
+        submitted_.store(n + 1, std::memory_order_release);
+    }
+
+    void sync() {
+        const uint64_t n = submitted_.load(std::memory_order_relaxed);
+        while (done_.load(std::memory_order_acquire) != n) std::this_thread::yield();
+    }
+
+    ~ScanlineWorker() {
+        stop_.store(true, std::memory_order_release);
+        if (thread_.joinable()) thread_.join();
+    }
+
+private:
+    static constexpr uint64_t kRing = 256;  // > 160 visible lines per frame
+
+    ScanlineWorker() : thread_([this] { run(); }) {}
+
+    void run() {
+        unsigned idle = 0;
+        while (!stop_.load(std::memory_order_acquire)) {
+            const uint64_t d = done_.load(std::memory_order_relaxed);
+            if (d == submitted_.load(std::memory_order_acquire)) {
+                // Lines arrive every ~50 us of guest time while a frame is
+                // drawn; spin briefly, then nap through VBlank and pauses.
+                if (++idle < 4096) std::this_thread::yield();
+                else std::this_thread::sleep_for(std::chrono::microseconds(200));
+                continue;
+            }
+            idle = 0;
+            const ScanlineJob& job = jobs_[d % kRing];
+            render_scanline_internal(job.fb, job.y, job.dispcnt, job.io.data(), job.vram,
+                                     job.oam.data(), job.pal.data(), GbaPpu::kScreenWidth,
+                                     GbaPpu::kScreenHeight);
+            done_.store(d + 1, std::memory_order_release);
+        }
+    }
+
+    std::array<ScanlineJob, kRing> jobs_{};
+    std::atomic<uint64_t> submitted_{0};
+    std::atomic<uint64_t> done_{0};
+    std::atomic<bool> stop_{false};
+    std::thread thread_;
+};
+
+void sync_scanline_worker() {
+    if (ScanlineWorker* w = ScanlineWorker::get()) w->sync();
+}
+
