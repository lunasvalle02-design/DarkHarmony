# Pinned upstream sources (cloned into ../external by scripts/fetch-sources.sh).
# To update: change a commit, run the fetch step and check that ../patches still applies.

# GBARecomp runtime. docs/FRAMEWORK_PIN.json names d11a362, but the generated code in
# src/game uses the tail-call macros (GBARECOMP_TAIL_CALL...) added after it, so the
# port pins the newest main commit that provides them.
GBARECOMP_REPO=https://github.com/mstan/gbarecomp.git
GBARECOMP_COMMIT=5e89943528aee7bc1c399bdbd035364a4b41dd10

# toml++ (only needed by GBARecomp's configure step; pinned to its v3.4.0 commit).
TOMLPP_REPO=https://github.com/marzer/tomlplusplus.git
TOMLPP_COMMIT=30172438cee64926dc41fdd9c11fb3ba5b2ba9de

# Target: Anbernic RG DS / RG DS Plus — Rockchip RK3568 (4x Cortex-A55, Mali-G52),
# two 4:3 panels. ROCKNIX builds it under the RK3566 device.
TARGET_TRIPLE=aarch64-linux-gnu
